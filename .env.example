# AutoCAD MCP Pro — Environment Variables

# Rendering (view_screenshot / drawing_export_pdf) is an install-time choice,
# not an env var — the core install cannot render at all. ezdxf's drawing
# add-on imports Pillow unconditionally, so every render path needs it:
#   pip install "autocad-mcp-pro[pdf]"   ezdxf backend, matplotlib renderer
#                                        (also pulls Pillow in transitively)
#   pip install "autocad-mcp-pro[full]"  every extra
# DWG read and write need the ODA File Converter on PATH.

# Seconds a DWG conversion waits for its private Xvfb display to come up
# (Linux; the converter needs a display). Default 30.
# XVFB_START_TIMEOUT=30

# Backend: auto | ezdxf (both run the headless ezdxf engine; anything else,
# com included, fails startup)
AUTOCAD_MCP_BACKEND=auto

# Comma-separated list of allowed directories for file operations.
# Leave empty to allow all paths (not recommended for production).
# Example: ALLOWED_PATHS=C:\Drawings,D:\Projects\CAD
ALLOWED_PATHS=

# Maximum undo stack size (number of snapshots to keep). The code's default is
# 5; this file used to say 50, which was a documentation-only disagreement.
MAX_UNDO_STACK=5

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Exposed tool profile: full (default) | lean
# lean is a curated 64-tool drafting/inspection set for clients with tight
# tool caps. The "core" profile was removed in v1.5.0 — the discovery layer
# below solves the crowded-surface problem it existed for. TOOL_PROFILE=core
# still boots, falling back to full with a warning.
TOOL_PROFILE=full

# Tool packs: all (default) | comma list of core,pid,settings,mech,arch,plant —
# advertise only the vertical packs this client uses. core is always on; an
# unknown entry is ignored with a warning and reported by system_about.
TOOL_PACKS=all

# Tool discovery: search (default since 1.8.0) | off
# "search" replaces the advertised catalog with search_tools, call_tool and
# describe_tool (plus the DISCOVERY_PINNED tools), so a client sees a handful
# of tools instead of the whole catalog and searches by AutoCAD command name
# ("QSELECT") or plain English ("round off this corner"). "off" advertises the
# full catalog, as 1.7.0 did. Every tool stays directly callable either way.
DISCOVERY_MODE=search

# Tools search mode lists beside the synthetic three (comma list; empty pins
# nothing). Static, so a client's prompt-cache prefix never moves.
DISCOVERY_PINNED=cad_batch,drawing_info,entity_list

# Per-call backend timeout in seconds; 0 disables the check.
# A hung call would otherwise hold the backend lock forever.
EZDXF_CALL_TIMEOUT=120

# Seconds shutdown waits for a worker thread still inside a call; after that
# the worker is logged and left on its daemon thread, so the process exits.
SHUTDOWN_GRACE=5

# Undo/redo history for the headless backend, in steps. 0 disables it.
# Not free: ezdxf has no journal, so each step is a full DXF snapshot.
# Measured 37x slower entity creation with it on (0.18 -> 6.65 ms/call),
# and a snapshot of a 5000-entity drawing costs 130 ms / 658 KB. For a
# single checkpoint use transaction_begin/rollback instead.
EZDXF_UNDO_DEPTH=0

# Ceiling on one QA read (drawing_critique, the validator, drawing_finalize,
# drawing_deliver). The entities of every space are counted first; a larger
# drawing is refused with scan_incomplete instead of being read in part.
# 0 disables the check; a negative value is refused at startup.
MAX_QA_ENTITIES=2000000

# --- Limits and remote access -------------------------------------------------
# These four are read by config.py but were missing from this file, which made
# it look like the complete list. Two of them are the remote-HTTP controls.

# Reject DXF input larger than this many bytes (512 MB). 0 disables the check.
MAX_DXF_BYTES=536870912

# Upper bound on list/selection response sizes.
MAX_LIST_LIMIT=5000

# Spec budgets: items per list of a pid_from_spec / arch_plan_from_spec
# document, and trays per parametric column. A larger request is refused by
# path, naming the variable. 0 disables a budget.
MAX_SPEC_ITEMS=2000
MAX_VESSEL_TRAYS=500

# Permit a non-loopback HTTP bind. Requires MCP_AUTH_TOKEN as well.
ALLOW_REMOTE_HTTP=false

# Bearer token required for remote HTTP. No default; remote binds refuse without it.
MCP_AUTH_TOKEN=

# --- Tool policy (1.8-17) -----------------------------------------------------
# The defaults keep 1.7's behaviour: every tool, every cost.
# READ_ONLY=true runs only `read` tools and writes no file (a write is refused
# policy_refused whatever the tool's label).
READ_ONLY=false
# Comma-separated tool names or globs. An allowlist advertises and runs only
# the listed tools; a denylist removes the listed ones. An entry naming no
# tool is warned about at startup. Example: TOOL_ALLOWLIST=entity_*,drawing_info
TOOL_ALLOWLIST=
TOOL_DENYLIST=
# Highest @cad_tool cost a call may carry: read | safe | mutate | destructive
# | escape (default: every tool). READ_ONLY implies read.
MAX_TOOL_COST=escape

# --- HTTP request guard (1.8-17) ----------------------------------------------
# A request carrying an Origin header is refused 403 unless the origin is
# listed here (default: none). A browser-based MCP inspector sends one: list
# its origin (e.g. http://localhost:6274) to use it.
HTTP_ALLOWED_ORIGINS=
# Host header values served besides the bound host:port (421 otherwise).
HTTP_ALLOWED_HOSTS=
# Idle HTTP keep-alive in seconds; keep it above the reverse proxy's upstream
# idle timeout (nginx/ALB 60 s, cloudflared 90 s) or it answers transient 502s.
HTTP_KEEPALIVE_S=120
# Request bodies over this many bytes are refused 413 (8 MiB); 0 disables.
MAX_HTTP_BODY_BYTES=8388608
# POST /files (uploads.py): one upload's limit, how long it is kept, its folder.
# UPLOAD_MAX_BYTES=268435456
# UPLOAD_RETAIN_S=86400
# UPLOAD_DIR=
# A second bearer token that carries only the mcp:read scope: requests with it
# run under the `read` ceiling. A non-loopback bind also requires ALLOWED_PATHS.
MCP_AUTH_TOKEN_READONLY=
