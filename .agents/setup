#!/usr/bin/env bash
# Amp orb setup: the headless engine (ezdxf, PNG/PDF rendering, XLSX) and the
# ODA File Converter, which drawing_open and drawing_save (.dwg) use for DWG.
set -euo pipefail
cd "$(dirname "$0")/.."

step() { echo "==> $1"; SECONDS=0; }
done_step() { echo "    done in ${SECONDS}s"; }

# ODA File Converter (DWG read and write) and the libraries it needs headless.
step "ODA File Converter"
scripts/install_oda.sh
done_step

step "Python dependencies (uv, headless extras)"
uv sync --locked --extra pdf --extra office
.venv/bin/python -c "from ezdxf.addons import odafc; assert odafc.is_installed(), 'ODA File Converter not found'"
done_step
